# .env.local로 복사해서 쓰세요. 배포 서버(Vercel)에는 대시보드 또는 `vercel env add`로 넣습니다.

# AI 보고서·검토 의견. 있으면 Gemini 무료 API, 없으면 로컬 Ollama를 씁니다.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# 로컬 Ollama (GEMINI_API_KEY가 없을 때)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# 태양광 입지 분석: 주소 → 지목·용도지역 조회. 발급: https://www.vworld.kr
VWORLD_KEY=
# 키 발급 때 등록한 서비스 URL (배포 서버는 https://<프로젝트>.vercel.app)
VWORLD_DOMAIN=http://localhost:3100

# 태양광 입지 분석: 조례 조회. 발급: https://open.law.go.kr (가입 이메일의 @ 앞부분)
LAW_OC=

# 태양광 발전량 예측: 기상청 단기예보. 없으면 Open-Meteo를 씁니다. 발급: https://www.data.go.kr
KMA_SERVICE_KEY=
